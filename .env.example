# Copy to .env.local for local development. Never commit real values.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Neon: use the *pooled* connection string).
# Leave empty in local development to use the embedded PGlite database,
# stored in ./.pglite (no install needed). Use "memory" for a throwaway one, or
# "pglite:./.pglite-demo" for the demo data made by `npm run db:seed-demo`.
DATABASE_URL=

# --- Site -------------------------------------------------------------------
# Public base URL, no trailing slash. Used to build the Discord OAuth redirect:
#   <APP_URL>/api/auth/callback
APP_URL=http://localhost:3000
# Secret used to sign session cookies: at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Discord sign-in (phase 1) ----------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The community server. Only its members can sign in.
DISCORD_GUILD_ID=
# Members holding this role are moderators (the role is named "ARCS Mod" by default).
DISCORD_MOD_ROLE_ID=

# --- Photo storage (phase 4) ------------------------------------------------
# Read-write token of a *private* Vercel Blob store. Vercel sets it when the
# store is connected to the project. Leave empty locally: photos then go to
# ./.photos-local instead.
BLOB_READ_WRITE_TOKEN=

# --- Discord bot (phase 3, not used yet) -------------------------------------
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ARCS_CHANNEL_ID=

# --- Development only -------------------------------------------------------
# Set to 1 to enable the localhost-only sign-in stub at /dev/sign-in.
# Ignored in production builds and on any host other than localhost.
DEV_AUTH_STUB=0
